[Unit]
Description=Wireproxy WARP exit %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/wireproxy -c %h/opencode2api/exits/wireproxy-%i.conf
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=default.target
